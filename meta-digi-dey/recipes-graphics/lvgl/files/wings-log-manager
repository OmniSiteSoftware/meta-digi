#!/bin/sh

set -eu

readonly HANDSHAKE_FILE="${LOG_STORAGE_HANDSHAKE_FILE:-/run/wings-storage-handshake}"
readonly STORAGE_DEVICE_STATE_FILE="${LOG_STORAGE_DEVICE_STATE_FILE:-/run/wings-storage-device.state}"
readonly STATUS_FILE="${LOG_SCRIPT_STATUS_FILE:-/run/wings-log-script.status}"
readonly CONTROL_FILE="${LOG_SCRIPT_CONTROL_FILE:-/run/wings-log-control.state}"
readonly SD_MOUNT_POINT="${LOG_SD_MOUNT:-}"
readonly USB_MOUNT_POINT="${LOG_USB_MOUNT:-}"
readonly APP_STORAGE_LOG_DIR_RELATIVE="${LOG_STORAGE_RELATIVE_DIR:-wings/logs/applog}"
readonly SYS_STORAGE_LOG_DIR_RELATIVE="${LOG_SYS_STORAGE_RELATIVE_DIR:-wings/logs/syslog}"
readonly RAM_LOG_DIR="${LOG_RAM_DIR:-/var/log}"
readonly RAM_LOG_FILE="${LOG_RAM_FILE:-/var/log/app_ram_log}"
readonly SYS_RAM_LOG_FILE="${LOG_SYS_RAM_FILE:-/var/log/sys_ram_log}"
readonly LOG_FILE_PREFIX="${LOG_FILE_PREFIX:-application_log}"
readonly SYS_LOG_SOURCE_FILE="${LOG_SYS_SOURCE_FILE:-/var/log/messages}"
readonly SYS_LOG_FILE_PREFIX="${LOG_SYS_FILE_PREFIX:-syslog}"
readonly SYS_LOG_OFFSET_FILE="${LOG_SYS_OFFSET_FILE:-/run/wings-syslog.offset}"
readonly APP_PID_FILE="${LOG_APP_PID_FILE:-/run/wings_app.pid}"
readonly LOG_MANAGER_VERSION="${LOG_MANAGER_VERSION:-2.0.0}"
readonly MAX_RAM_LOG_BYTES="${LOG_MAX_RAM_BYTES:-5242880}"
readonly FLUSH_INTERVAL_SECS="${LOG_FLUSH_INTERVAL_SECS:-120}"
readonly STORAGE_USAGE_LIMIT_PERCENT="${LOG_STORAGE_USAGE_LIMIT_PERCENT:-90}"
readonly RETENTION_DAYS="${LOG_RETENTION_DAYS:-7}"
readonly POLL_INTERVAL_SECS="${LOG_MANAGER_POLL_INTERVAL_SECS:-5}"
readonly RAM_POLL_INTERVAL_SECS="${LOG_RAM_POLL_INTERVAL_SECS:-1}"
readonly STORAGE_TIMEOUT_SECS="${LOG_STORAGE_TIMEOUT_SECS:-30}"
readonly WORKER_RETRY_SECS="${LOG_WORKER_RETRY_SECS:-30}"
readonly STORAGE_PROGRESS_FILE="${LOG_STORAGE_PROGRESS_FILE:-}"
readonly SYS_PROGRESS_FILE="${LOG_SYS_PROGRESS_FILE:-}"
readonly RUNTIME_DIR="${LOG_MANAGER_RUNTIME_DIR:-}"
readonly DEFAULT_TARGET="${LOG_DEFAULT_TARGET:-SD}"

manager_log() {
    logger -t "wings-log-manager" "$1"
}

timestamp() {
    date '+%Y-%m-%d %H:%M:%S'
}

write_status() {
    state="$1"
    target="$2"
    target_device="$3"
    target_dir="$4"
    target_file="$5"
    reason="$6"
    ram_file="$7"
    last_log_write_at="$8"
    last_flush_at="$9"
    ram_log_size="${10}"
    last_log_write_epoch="${11}"
    last_flush_epoch_value="${12}"
    sys_log_file="${13}"
    last_sys_flush_at="${14}"
    last_sys_flush_epoch_value="${15}"
    sys_log_size="${16}"
    updated_at_epoch="$(date '+%s')"
    status_dir="$(dirname "$STATUS_FILE")"
    status_tmp="${STATUS_FILE}.tmp.$$"

    mkdir -p "$status_dir" 2>/dev/null || true

    {
        printf 'STATE=%s\n' "$state"
        printf 'TARGET=%s\n' "$target"
        printf 'TARGET_DEVICE=%s\n' "$target_device"
        printf 'TARGET_DIR=%s\n' "$target_dir"
        printf 'TARGET_FILE=%s\n' "$target_file"
        printf 'RAM_LOG_FILE=%s\n' "$ram_file"
        printf 'LAST_LOG_WRITE_AT=%s\n' "$last_log_write_at"
        printf 'LAST_LOG_WRITE_EPOCH=%s\n' "$last_log_write_epoch"
        printf 'LAST_FLUSH_AT=%s\n' "$last_flush_at"
        printf 'LAST_FLUSH_EPOCH=%s\n' "$last_flush_epoch_value"
        printf 'RAM_LOG_SIZE_BYTES=%s\n' "$ram_log_size"
        printf 'SYS_LOG_FILE=%s\n' "$sys_log_file"
        printf 'LAST_SYS_FLUSH_AT=%s\n' "$last_sys_flush_at"
        printf 'LAST_SYS_FLUSH_EPOCH=%s\n' "$last_sys_flush_epoch_value"
        printf 'SYS_LOG_SIZE_BYTES=%s\n' "$sys_log_size"
        printf 'SCRIPT_VERSION=%s\n' "$LOG_MANAGER_VERSION"
        printf 'REASON=%s\n' "$reason"
        printf 'UPDATED_AT=%s\n' "$(timestamp)"
        printf 'UPDATED_AT_EPOCH=%s\n' "$updated_at_epoch"
    } > "$status_tmp"

    mv -f "$status_tmp" "$STATUS_FILE"
}

normalize_target() {
    normalize_value="$1"

    case "$normalize_value" in
        SD|SD:*)
            printf 'SD\n'
            ;;
        USB|USB:*)
            printf 'USB\n'
            ;;
        *)
            printf '%s\n' "$DEFAULT_TARGET"
            ;;
    esac
}

read_target() {
    if [ -f "$HANDSHAKE_FILE" ]; then
        tr -d '[:space:]' < "$HANDSHAKE_FILE"
    else
        printf '%s\n' "$DEFAULT_TARGET"
    fi
}

read_target_device() {
    raw_target_value="$(read_target)"

    case "$raw_target_value" in
        USB:*)
            printf '%s\n' "${raw_target_value#USB:}"
            ;;
        *)
            printf '\n'
            ;;
    esac
}

read_logging_enabled() {
    control_value=""

    if [ -f "$CONTROL_FILE" ]; then
        control_value="$(tr -d '[:space:]' < "$CONTROL_FILE" 2>/dev/null || printf '1')"
        case "$control_value" in
            0|DISABLED|disabled|false|FALSE)
                printf '0\n'
                return
                ;;
        esac
    fi

    printf '1\n'
}

read_storage_state_field() {
    field_key="$1"

    [ -f "$STORAGE_DEVICE_STATE_FILE" ] || return 1

    while IFS= read -r line; do
        case "$line" in
            "$field_key"=*)
                printf '%s\n' "${line#*=}"
                return 0
                ;;
        esac
    done < "$STORAGE_DEVICE_STATE_FILE"

    return 1
}

resolve_selected_usb_field() {
    resolve_selected_device="$1"
    resolve_field_name="$2"
    resolve_usb_count="$(read_storage_state_field "USB_COUNT" 2>/dev/null || printf '0\n')"
    resolve_index=0

    while [ "$resolve_index" -lt "$resolve_usb_count" ]; do
        resolve_device_name="$(read_storage_state_field "USB_DEVICE_${resolve_index}" 2>/dev/null || printf '\n')"
        if [ "$resolve_device_name" = "$resolve_selected_device" ]; then
            read_storage_state_field "USB_${resolve_field_name}_${resolve_index}" 2>/dev/null
            return 0
        fi
        resolve_index=$((resolve_index + 1))
    done

    return 1
}

find_first_ready_usb_device() {
    ready_usb_count="$(read_storage_state_field "USB_COUNT" 2>/dev/null || printf '0\n')"
    ready_index=0

    while [ "$ready_index" -lt "$ready_usb_count" ]; do
        ready_device_name="$(read_storage_state_field "USB_DEVICE_${ready_index}" 2>/dev/null || printf '\n')"
        ready_device_state="$(read_storage_state_field "USB_STATE_${ready_index}" 2>/dev/null || printf 'NOT_CONNECTED\n')"
        if [ "$ready_device_state" = "MOUNTED" ]; then
            ready_device_dir="$(resolve_target_dir "USB" "$ready_device_name" 2>/dev/null || printf '%s\n' "-")"
            if [ "$ready_device_dir" != "-" ] && is_path_usable "USB" "$ready_device_dir"; then
                printf '%s\n' "$ready_device_name"
                return 0
            fi
        fi
        ready_index=$((ready_index + 1))
    done

    return 1
}

find_best_usb_device() {
    preferred_device_name="${1:-}"

    if [ -n "$preferred_device_name" ]; then
        preferred_device_state="$(resolve_selected_usb_field "$preferred_device_name" "STATE" 2>/dev/null || printf 'NOT_CONNECTED\n')"
        if [ "$preferred_device_state" = "MOUNTED" ]; then
            preferred_device_dir="$(resolve_target_dir "USB" "$preferred_device_name" 2>/dev/null || printf '%s\n' "-")"
            if [ "$preferred_device_dir" != "-" ] && is_path_usable "USB" "$preferred_device_dir"; then
                printf '%s\n' "$preferred_device_name"
                return 0
            fi
        fi
    fi

    find_first_ready_usb_device
}

resolve_target_dir() {
    resolve_target="$1"
    resolve_selected_device="${2:-}"
    resolve_base_dir=""

    case "$resolve_target" in
        SD)
            resolve_base_dir="$(read_storage_state_field "SD_MOUNTPOINT" 2>/dev/null || printf '%s\n' "$SD_MOUNT_POINT")"
            ;;
        USB)
            if [ -n "$resolve_selected_device" ]; then
                resolve_base_dir="$(resolve_selected_usb_field "$resolve_selected_device" "MOUNTPOINT" 2>/dev/null || printf '%s\n' "$USB_MOUNT_POINT")"
            else
                resolve_base_dir="$(read_storage_state_field "USB_MOUNTPOINT" 2>/dev/null || printf '%s\n' "$USB_MOUNT_POINT")"
            fi
            ;;
        *)
            return 1
            ;;
    esac

    [ -n "$resolve_base_dir" ] || return 1
    [ "$resolve_base_dir" != "-" ] || return 1
    printf '%s/%s\n' "$resolve_base_dir" "$APP_STORAGE_LOG_DIR_RELATIVE"
}

resolve_log_dir_from_base() {
    resolve_base_dir="$1"
    resolve_relative_dir="$2"

    [ -n "$resolve_base_dir" ] || return 1
    [ "$resolve_base_dir" != "-" ] || return 1
    printf '%s/%s\n' "$resolve_base_dir" "$resolve_relative_dir"
}

resolve_target_log_file() {
    resolve_target_dir_value="$1"
    resolve_timestamp_part=""

    [ -n "$resolve_target_dir_value" ] || return 1
    [ "$resolve_target_dir_value" != "-" ] || return 1
    resolve_timestamp_part="$(date -u '+%Y%m%d_%H')"
    printf '%s/%s_%s.log\n' "$resolve_target_dir_value" "$LOG_FILE_PREFIX" "$resolve_timestamp_part"
}

resolve_sys_target_log_file() {
    resolve_target_dir_value="$1"
    resolve_timestamp_part=""

    [ -n "$resolve_target_dir_value" ] || return 1
    [ "$resolve_target_dir_value" != "-" ] || return 1
    resolve_timestamp_part="$(date -u '+%Y%m%d_%H')"
    printf '%s/%s_%s.log\n' "$resolve_target_dir_value" "$SYS_LOG_FILE_PREFIX" "$resolve_timestamp_part"
}

is_path_usable() {
    path_target="$1"
    path_target_dir="$2"
    path_base_path="${path_target_dir%/${APP_STORAGE_LOG_DIR_RELATIVE}}"

    case "$path_target" in
        SD|USB)
            [ -n "$path_base_path" ] && [ "$path_base_path" != "-" ]
            ;;
        *)
            return 1
            ;;
    esac
}

ensure_target_files() {
    ensure_target_dir="$1"
    ensure_target_file="$2"
    ensure_base_path="${ensure_target_dir%/${APP_STORAGE_LOG_DIR_RELATIVE}}"
    ensure_marker_dir="${ensure_base_path}/wings/.meta"
    ensure_marker_file="${ensure_marker_dir}/handshake.log"

    mkdir -p "$ensure_target_dir" || return 1
    mkdir -p "$ensure_marker_dir" || return 1
    true >> "$ensure_target_file" || return 1
    printf '[%s] hello i am handshaked\n' "$(timestamp)" >> "$ensure_marker_file"
}

ensure_sys_log_source_file() {
    if [ -e "$SYS_LOG_SOURCE_FILE" ] && [ ! -f "$SYS_LOG_SOURCE_FILE" ]; then
        return 1
    fi
    ensure_sys_log_dir="$(dirname "$SYS_LOG_SOURCE_FILE")"
    mkdir -p "$ensure_sys_log_dir" || return 1
    # Unlike the special builtin ':', true lets ash return a redirection error
    # to the caller instead of terminating the manager on a filesystem failure.
    true >> "$SYS_LOG_SOURCE_FILE" || return 1
}

ensure_sys_ram_log_file() {
    mkdir -p "$RAM_LOG_DIR" || return 1
    true >> "$SYS_RAM_LOG_FILE" || return 1
}

read_sys_log_offset() {
    if [ -f "$SYS_LOG_OFFSET_FILE" ]; then
        offset_value=""
        read -r offset_value < "$SYS_LOG_OFFSET_FILE" || offset_value=0
        case "$offset_value" in
            ''|*[!0-9]*)
                printf '0\n'
                ;;
            *)
                printf '%s\n' "$offset_value"
                ;;
        esac
    else
        printf '0\n'
    fi
}

write_sys_log_offset() {
    offset_value="$1"
    offset_dir="$(dirname "$SYS_LOG_OFFSET_FILE")"
    mkdir -p "$offset_dir" 2>/dev/null || true
    offset_tmp="$RUNTIME_DIR/source.offset.tmp"
    printf '%s\n%s\n' "$offset_value" "$2" > "$offset_tmp" || return 1
    mv -f "$offset_tmp" "$SYS_LOG_OFFSET_FILE"
}

ensure_ram_log_file() {
    mkdir -p "$RAM_LOG_DIR" || return 1
    true >> "$RAM_LOG_FILE" || return 1
}

ram_log_size_bytes() {
    if [ -f "$RAM_LOG_FILE" ]; then
        stat -L -c '%s' "$RAM_LOG_FILE"
    else
        printf '0\n'
    fi
}

trim_ram_log_to_limit() {
    if [ "$guard_runtime_ready" = 1 ]; then
        trim_log_to_limit "$RAM_LOG_FILE" "$guard_runtime_dir/app.generation"
    else
        trim_log_to_limit "$RAM_LOG_FILE" ""
    fi
}

sys_ram_log_size_bytes() {
    if [ -f "$SYS_RAM_LOG_FILE" ]; then
        stat -L -c '%s' "$SYS_RAM_LOG_FILE"
    else
        printf '0\n'
    fi
}

trim_sys_ram_log_to_limit() {
    if [ "$guard_runtime_ready" = 1 ]; then
        trim_log_to_limit "$SYS_RAM_LOG_FILE" "$guard_runtime_dir/sys.generation"
    else
        trim_log_to_limit "$SYS_RAM_LOG_FILE" ""
    fi
}

read_generation() {
    generation_value=""
    read -r generation_value < "$1" || return 1
    case "$generation_value" in ''|*[!0-9]*) return 1 ;; esac
    printf '%s\n' "$generation_value"
}

trim_log_to_limit() {
    trim_file="$1"
    trim_generation_file="$2"
    trim_current_size="$(stat -L -c '%s' "$trim_file")" || return 1
    [ "$trim_current_size" -ge "$MAX_RAM_LOG_BYTES" ] || return 0
    # Before runtime setup succeeds there are no workers or flush cursors.
    # Reclaim RAM directly, without depending on /run being writable.
    if [ -z "$trim_generation_file" ]; then
        true > "$trim_file"
        return "$?"
    fi
    trim_result=0
    trim_generation="$(read_generation "$trim_generation_file")" || {
        trim_generation=0
        trim_result=1
    }
    # Recover a generation left odd by an earlier failed clear notification.
    trim_generation=$((trim_generation + trim_generation % 2))

    # Only the supervisor clears RAM buffers. Odd generations mean a clear is
    # in progress; even generations identify a stable buffer for flush cursors.
    # IPC failure must never prevent RAM reclamation. Losing flush cursor
    # metadata is preferable to leaving a full live log growing indefinitely.
    if printf '%s\n' "$((trim_generation + 1))" > "$trim_generation_file.tmp"; then
        mv -f "$trim_generation_file.tmp" "$trim_generation_file" || trim_result=1
    else
        trim_result=1
    fi
    true > "$trim_file" || trim_result=1
    if printf '%s\n' "$((trim_generation + 2))" > "$trim_generation_file.tmp"; then
        mv -f "$trim_generation_file.tmp" "$trim_generation_file" || trim_result=1
    else
        trim_result=1
    fi
    return "$trim_result"
}

sync_sys_log_source_to_ram() {
    sync_current_offset="$(read_sys_log_offset)"

    ensure_sys_log_source_file || return 1
    ensure_sys_ram_log_file || return 1
    [ -f "$SYS_LOG_SOURCE_FILE" ] || return 1

    sync_source_metadata="$(stat -L -c '%d:%i %s' "$SYS_LOG_SOURCE_FILE" 2>/dev/null)" || return 1
    sync_source_identity="${sync_source_metadata% *}"
    sync_current_size="${sync_source_metadata##* }"
    if [ "$sync_source_identity" != "$source_identity" ]; then
        # A newly created messages file is new input even when it is the same
        # size as (or larger than) the last file read before syslog rotation.
        sync_current_offset=0
    fi
    case "$sync_current_size" in
        ''|*[!0-9]*)
            sync_current_size=0
            ;;
    esac
    case "$sync_current_offset" in
        ''|*[!0-9]*)
            sync_current_offset=0
            ;;
    esac

    if [ "$sync_current_size" -lt "$sync_current_offset" ]; then
        sync_current_offset=0
    fi

    [ "$sync_current_size" -gt "$sync_current_offset" ] || return 0

    # Keep only the newest bounded input when a large backlog has accumulated.
    # Never append an unbounded source and hope a later trim can reclaim it.
    sync_ram_size="$(sys_ram_log_size_bytes)"
    sync_budget=$((MAX_RAM_LOG_BYTES - sync_ram_size))
    [ "$sync_budget" -gt 0 ] || sync_budget=0
    sync_copy_bytes=$((sync_current_size - sync_current_offset))
    if [ "$sync_copy_bytes" -gt "$sync_budget" ]; then
        sync_copy_bytes="$sync_budget"
        sync_current_offset=$((sync_current_size - sync_copy_bytes))
    fi

    # Prefer dropping a failed batch over appending it repeatedly on retries.
    write_sys_log_offset "$sync_current_size" "$sync_source_identity" || return 1
    source_identity="$sync_source_identity"
    [ "$sync_copy_bytes" -gt 0 ] || return 0
    copy_log_bytes "$SYS_LOG_SOURCE_FILE" "$SYS_RAM_LOG_FILE" "$sync_current_offset" "$sync_copy_bytes"
}

copy_log_bytes() {
    copy_source="$1"
    copy_destination="$2"
    copy_offset="$3"
    copy_bytes="$4"
    copy_blocks=$((copy_bytes / 4096))
    copy_remainder=$((copy_bytes % 4096))

    # BusyBox supports skip_bytes. Use small blocks, not a second RAM-sized
    # snapshot or a potentially endless cat of a file that is still growing.
    if [ "$copy_blocks" -gt 0 ]; then
        dd if="$copy_source" bs=4096 iflag=skip_bytes skip="$copy_offset" count="$copy_blocks" 2>/dev/null >> "$copy_destination" || return 1
    fi
    if [ "$copy_remainder" -gt 0 ]; then
        dd if="$copy_source" bs=1 skip="$((copy_offset + copy_blocks * 4096))" count="$copy_remainder" 2>/dev/null >> "$copy_destination" || return 1
    fi
    return 0
}

target_storage_usage_percent() {
    usage_target_dir="$1"

    df -P "$usage_target_dir" 2>/dev/null | awk 'NR==2 { gsub("%", "", $5); print $5 }'
}

cleanup_old_logs() {
    cleanup_target_dir="$1"

    find "$cleanup_target_dir" -maxdepth 1 -type f -name "${LOG_FILE_PREFIX}_*.log" -mtime +"$RETENTION_DAYS" -exec rm -f {} \; 2>/dev/null || true
}

cleanup_old_sys_logs() {
    cleanup_target_dir="$1"

    find "$cleanup_target_dir" -maxdepth 1 -type f -name "${SYS_LOG_FILE_PREFIX}_*.log" -mtime +"$RETENTION_DAYS" -exec rm -f {} \; 2>/dev/null || true
}

flush_ram_log_to_target() {
    flush_buffer_to_target APP "$RAM_LOG_FILE" "$RUNTIME_DIR/app.generation" "$1" "$2"
}

flush_sys_log_to_target() {
    flush_buffer_to_target SYS "$SYS_RAM_LOG_FILE" "$RUNTIME_DIR/sys.generation" "$1" "$2"
}

read_process_identity() {
    process_pid="$1"
    case "$process_pid" in ''|*[!0-9]*) printf '%s\n' '-'; return ;; esac
    if ! read -r process_stat < "/proc/$process_pid/stat"; then
        printf '%s\n' '-'
        return
    fi
    # Strip PID/comm (which can contain spaces). Start time is field 20 of
    # the remainder, distinguishing a restarted process even if its PID recurs.
    process_fields="${process_stat##*) }"
    set -- $process_fields
    if [ "$#" -lt 20 ]; then
        printf '%s\n' '-'
        return
    fi
    printf '%s:%s\n' "$process_pid" "${20}"
}

read_application_identity() {
    application_pid=""
    if [ ! -f "$APP_PID_FILE" ] || ! read -r application_pid < "$APP_PID_FILE"; then
        printf '%s\n' '-'
        return
    fi
    read_process_identity "$application_pid"
}

flush_buffer_to_target() {
    flush_did_copy=0
    flush_kind="$1"
    flush_source="$2"
    flush_generation_file="$3"
    flush_target_dir="$4"
    flush_target_file="$5"
    [ -s "$flush_source" ] || return 0
    if [ "$flush_kind" = APP ]; then
        flush_app_identity="$(read_application_identity)"
    fi
    flush_generation="$(read_generation "$flush_generation_file")" || return 1
    [ $((flush_generation % 2)) -eq 0 ] || return 1
    flush_snapshot_size="$(stat -L -c '%s' "$flush_source")" || return 1
    [ "$flush_snapshot_size" -le "$MAX_RAM_LOG_BYTES" ] || flush_snapshot_size="$MAX_RAM_LOG_BYTES"
    case "$flush_kind" in
        APP)
            flush_offset="$app_flush_offset"
            if [ "$flush_app_identity" != "$app_flush_identity" ]; then
                flush_offset=0
            fi
            flush_previous_generation="$app_flush_generation"
            cleanup_old_logs "$flush_target_dir"
            ;;
        SYS)
            flush_offset="$sys_flush_offset"
            flush_previous_generation="$sys_flush_generation"
            cleanup_old_sys_logs "$flush_target_dir"
            ;;
    esac
    if [ "$flush_generation" != "$flush_previous_generation" ] ||
       [ "$flush_snapshot_size" -lt "$flush_offset" ]; then
        flush_offset=0
    fi
    [ "$flush_snapshot_size" -gt "$flush_offset" ] || return 0
    flush_usage_percent="$(target_storage_usage_percent "$flush_target_dir" 2>/dev/null)" || return 1
    case "$flush_usage_percent" in ''|*[!0-9]*) return 1 ;; esac
    [ "$flush_usage_percent" -lt "$STORAGE_USAGE_LIMIT_PERCENT" ] || return 2
    mkdir -p "$flush_target_dir" || return 1
    flush_copy_bytes=$((flush_snapshot_size - flush_offset))
    copy_log_bytes "$flush_source" "$flush_target_file" "$flush_offset" "$flush_copy_bytes" || return 1
    flush_after_generation="$(read_generation "$flush_generation_file")" || return 1
    if [ "$flush_kind" = APP ] &&
       [ "$(read_application_identity)" != "$flush_app_identity" ]; then
        return 1
    fi

    # Never clear a live buffer after copying a snapshot: the application or
    # source worker may already have appended new logs. Save a cursor instead.
    # A threshold clear may discard a batch during copying; retry the new
    # generation from zero, without erasing any of its newly arrived data.
    if [ "$flush_after_generation" != "$flush_generation" ]; then
        return 1
    fi
    case "$flush_kind" in
        APP)
            app_flush_offset="$flush_snapshot_size"
            app_flush_generation="$flush_generation"
            app_flush_identity="$flush_app_identity"
            ;;
        SYS) sys_flush_offset="$flush_snapshot_size"; sys_flush_generation="$flush_generation" ;;
    esac
    flush_did_copy=1
    return 0
}

evaluate_target_status() {
    eval_target="$1"
    eval_selected_device="${2:-}"
    eval_resolved_device="$eval_selected_device"

    target_state="UNKNOWN"
    target_dir="-"
    target_file="-"
    reason="target-state-unknown"

    case "$eval_target" in
        SD)
            target_state="$(read_storage_state_field "SD_STATE" 2>/dev/null || printf 'NOT_CONNECTED\n')"
            if [ "$target_state" = "MOUNTED" ]; then
                target_dir="$(resolve_target_dir "$eval_target" 2>/dev/null || printf '%s\n' "-")"
                target_file="$(resolve_target_log_file "$target_dir" 2>/dev/null || printf '%s\n' "-")"
                if [ "$target_dir" = "-" ] || ! is_path_usable "$eval_target" "$target_dir"; then
                    reason="target-not-ready"
                else
                    reason="target-mounted"
                fi
            elif [ "$target_state" = "UNMOUNTED" ]; then
                reason="target-unmounted"
            else
                reason="target-not-connected"
            fi
            ;;
        USB)
            if [ -n "$eval_selected_device" ]; then
                eval_resolved_device="$(find_best_usb_device "$eval_selected_device" 2>/dev/null || printf '\n')"
            else
                eval_resolved_device="$(find_best_usb_device "" 2>/dev/null || printf '\n')"
            fi

            if [ -n "$eval_resolved_device" ]; then
                target_state="$(resolve_selected_usb_field "$eval_resolved_device" "STATE" 2>/dev/null || printf 'NOT_CONNECTED\n')"
                target_dir="$(resolve_target_dir "$eval_target" "$eval_resolved_device" 2>/dev/null || printf '%s\n' "-")"
                target_file="$(resolve_target_log_file "$target_dir" 2>/dev/null || printf '%s\n' "-")"
                selected_device="$eval_resolved_device"
            else
                target_state="$(read_storage_state_field "USB_STATE" 2>/dev/null || printf 'NOT_CONNECTED\n')"
                selected_device=""
            fi

            if [ "$target_state" = "MOUNTED" ]; then
                if [ "$target_dir" = "-" ] || ! is_path_usable "$eval_target" "$target_dir"; then
                    reason="target-not-ready"
                else
                    reason="target-mounted"
                fi
            elif [ "$target_state" = "UNMOUNTED" ]; then
                reason="target-unmounted"
            else
                reason="target-not-connected"
            fi
            ;;
        *)
            return 1
            ;;
    esac

    return 0
}

monitor_loop() {
    app_flush_offset=0
    app_flush_generation=""
    app_flush_identity=""
    sys_flush_offset=0
    sys_flush_generation=""
    last_target=""
    last_state=""
    last_reason=""
    last_target_dir=""
    last_target_file=""
    last_marker_key=""
    marker_status="IDLE"
    marker_retry_epoch=0
    last_flush_epoch="$(date '+%s')"
    last_sys_flush_epoch="$(date '+%s')"
    last_log_write_at="-"
    last_log_write_epoch=0
    last_flush_at="-"
    last_flush_epoch_value=0
    last_sys_flush_at="-"
    last_sys_flush_epoch_value=0
    sys_log_size=0
    fallback_target=""
    fallback_device=""
    last_requested_key=""
    last_connected_mount_key=""
    cleanup_pending=0

    # The supervisor owns public status and shutdown. This worker can be
    # discarded without making RAM maintenance wait for removable storage.
    trap 'exit 0' INT TERM

    manager_log "starting log manager"
    write_status "STARTING" "$(normalize_target "$(read_target)")" "-" "-" "-" "service-start" "$RAM_LOG_FILE" "$last_log_write_at" "$last_flush_at" "0" "$last_log_write_epoch" "$last_flush_epoch_value" "-" "$last_sys_flush_at" "$last_sys_flush_epoch_value" "0"

    while true; do
        printf '%s\n' "$(monotonic_seconds)" > "$STORAGE_PROGRESS_FILE"
        now_epoch="$(date '+%s')"
        logging_enabled="$(read_logging_enabled)"
        target_raw="$(read_target)"
        requested_target="$(normalize_target "$target_raw")"
        requested_device="$(read_target_device)"
        requested_key="${requested_target}|${requested_device}"
        target="$requested_target"
        target_device="$requested_device"
        target_dir="-"
        target_file="-"
        state="WAITING"
        reason="target-state-unknown"
        target_state="UNKNOWN"
        sys_target_dir="-"
        sys_target_file="-"

        if [ "$requested_key" != "$last_requested_key" ]; then
            fallback_target=""
            fallback_device=""
            last_requested_key="$requested_key"
        fi

        ram_log_size="$(ram_log_size_bytes)"
        sys_log_size="$(sys_ram_log_size_bytes)"
        case "$ram_log_size" in
            ''|*[!0-9]*)
                ram_log_size=0
                ;;
        esac
        case "$sys_log_size" in
            ''|*[!0-9]*)
                sys_log_size=0
                ;;
        esac

        if [ "$logging_enabled" = "0" ]; then
            state="IDLE"
            reason="logging-disabled"
        else
            case "$requested_target" in
                SD)
                    if [ "$fallback_target" = "USB" ]; then
                        target="USB"
                        target_device="$fallback_device"
                        evaluate_target_status "$target" "$target_device"
                        target_device="${selected_device:-$fallback_device}"

                        if [ "$reason" != "target-mounted" ]; then
                            evaluate_target_status "SD" ""
                            if [ "$reason" = "target-mounted" ]; then
                                fallback_target=""
                                fallback_device=""
                                target="SD"
                                target_device=""
                            else
                                fallback_candidate="$(find_first_ready_usb_device 2>/dev/null || printf '\n')"
                                if [ -n "$fallback_candidate" ]; then
                                    fallback_target="USB"
                                    fallback_device="$fallback_candidate"
                                    target="USB"
                                    target_device="$fallback_device"
                                    evaluate_target_status "$target" "$target_device"
                                    target_device="${selected_device:-$fallback_device}"
                                else
                                    target="SD"
                                    target_device=""
                                fi
                            fi
                        fi
                    else
                        evaluate_target_status "SD" ""
                        if [ "$reason" = "target-mounted" ]; then
                            target="SD"
                            target_device=""
                        else
                            fallback_candidate="$(find_first_ready_usb_device 2>/dev/null || printf '\n')"
                            if [ -n "$fallback_candidate" ]; then
                                fallback_target="USB"
                                fallback_device="$fallback_candidate"
                                target="USB"
                                target_device="$fallback_device"
                                evaluate_target_status "$target" "$target_device"
                                target_device="${selected_device:-$fallback_device}"
                            else
                                target="SD"
                                target_device=""
                            fi
                        fi
                    fi
                    ;;
                USB)
                    if [ "$fallback_target" = "SD" ]; then
                        evaluate_target_status "USB" "${requested_device:-}"
                        target="USB"
                        target_device="${selected_device:-${requested_device:-}}"
                        if [ "$reason" = "target-mounted" ]; then
                            fallback_target=""
                            fallback_device=""
                        else
                            evaluate_target_status "SD" ""
                            if [ "$reason" = "target-mounted" ]; then
                                target="SD"
                                target_device=""
                            else
                                target="USB"
                                target_device="${selected_device:-${requested_device:-}}"
                            fi
                        fi
                    else
                        evaluate_target_status "USB" "${requested_device:-}"
                        target="USB"
                        target_device="${selected_device:-${requested_device:-}}"
                        if [ "$reason" != "target-mounted" ]; then
                            evaluate_target_status "SD" ""
                            if [ "$reason" = "target-mounted" ]; then
                                fallback_target="SD"
                                fallback_device=""
                                target="SD"
                                target_device=""
                            else
                                target="USB"
                                target_device="${selected_device:-${requested_device:-}}"
                            fi
                        else
                            fallback_target=""
                            fallback_device=""
                        fi
                    fi
                    ;;
            esac
        fi

        marker_key="${logging_enabled}|${target}|${target_device}|${target_state}|${target_dir}|${target_file}"
        if [ "$marker_key" != "$last_marker_key" ]; then
            marker_status="IDLE"
            last_marker_key="$marker_key"
        fi

        current_mount_key=""
        if [ "$reason" = "target-mounted" ]; then
            current_mount_key="${target}|${target_device}|${target_dir}"
            if [ "$current_mount_key" != "$last_connected_mount_key" ]; then
                cleanup_pending="1"
                last_connected_mount_key="$current_mount_key"
            fi

            target_base_dir="${target_dir%/${APP_STORAGE_LOG_DIR_RELATIVE}}"
            sys_target_dir="$(resolve_log_dir_from_base "$target_base_dir" "$SYS_STORAGE_LOG_DIR_RELATIVE" 2>/dev/null || printf '%s\n' "-")"
            sys_target_file="$(resolve_sys_target_log_file "$sys_target_dir" 2>/dev/null || printf '%s\n' "-")"
        else
            last_connected_mount_key=""
        fi

        if [ "$reason" = "target-mounted" ]; then
            if [ "$cleanup_pending" = "1" ]; then
                cleanup_old_logs "$target_dir"
                if [ "$sys_target_dir" != "-" ]; then
                    cleanup_old_sys_logs "$sys_target_dir"
                fi
                cleanup_pending="0"
            fi

            if [ "$marker_status" = "FAILED" ] &&
               [ "$now_epoch" -ge "$marker_retry_epoch" ]; then
                marker_status="IDLE"
            fi
            if [ "$marker_status" = "IDLE" ]; then
                marker_retry_epoch=$((now_epoch + WORKER_RETRY_SECS))
                if ensure_target_files "$target_dir" "$target_file"; then
                    if [ "$sys_target_dir" != "-" ]; then
                        mkdir -p "$sys_target_dir" || {
                            marker_status="FAILED"
                            state="WAITING"
                            reason="target-io-error"
                            write_status "$state" "$target" "$target_device" "$target_dir" "$target_file" "$reason" "$RAM_LOG_FILE" "$last_log_write_at" "$last_flush_at" "$ram_log_size" "$last_log_write_epoch" "$last_flush_epoch_value" "$sys_target_file" "$last_sys_flush_at" "$last_sys_flush_epoch_value" "$sys_log_size"
                            sleep "$POLL_INTERVAL_SECS"
                            continue
                        }
                        true >> "$sys_target_file" || {
                            marker_status="FAILED"
                            state="WAITING"
                            reason="target-io-error"
                            write_status "$state" "$target" "$target_device" "$target_dir" "$target_file" "$reason" "$RAM_LOG_FILE" "$last_log_write_at" "$last_flush_at" "$ram_log_size" "$last_log_write_epoch" "$last_flush_epoch_value" "$sys_target_file" "$last_sys_flush_at" "$last_sys_flush_epoch_value" "$sys_log_size"
                            sleep "$POLL_INTERVAL_SECS"
                            continue
                        }
                    fi
                    marker_status="DONE"
                    state="ACTIVE"
                    last_log_write_at="$(timestamp)"
                    last_log_write_epoch="$now_epoch"
                    reason="target-ready"
                else
                    marker_status="FAILED"
                    state="WAITING"
                    reason="target-io-error"
                fi
            elif [ "$marker_status" = "DONE" ]; then
                state="ACTIVE"
                reason="target-ready"
            else
                state="WAITING"
                reason="target-io-error"
            fi

            # A full card may contain expired syslogs as well as application
            # logs. Reclaim both before an app flush can put us into WAITING.
            if [ "$state" = "ACTIVE" ] &&
               [ $((now_epoch - last_flush_epoch)) -ge "$FLUSH_INTERVAL_SECS" ]; then
                cleanup_old_logs "$target_dir"
                if [ "$sys_target_dir" != "-" ]; then
                    cleanup_old_sys_logs "$sys_target_dir"
                fi
            fi

            if [ "$state" = "ACTIVE" ] && [ "$ram_log_size" -gt 0 ]; then
                if [ "$ram_log_size" -ge "$MAX_RAM_LOG_BYTES" ] ||
                   [ $((now_epoch - last_flush_epoch)) -ge "$FLUSH_INTERVAL_SECS" ]; then
                    if flush_ram_log_to_target "$target_dir" "$target_file"; then
                        last_flush_epoch="$now_epoch"
                        if [ "$flush_did_copy" = "1" ]; then
                            last_log_write_at="$(timestamp)"
                            last_log_write_epoch="$now_epoch"
                            last_flush_at="$(timestamp)"
                            last_flush_epoch_value="$now_epoch"
                        fi
                        reason="target-ready"
                    else
                        flush_result="$?"
                        state="WAITING"
                        if [ "$flush_result" -eq 2 ]; then
                            reason="target-storage-full"
                        else
                            reason="target-flush-failed"
                        fi
                    fi
                fi
            fi

            if [ "$state" = "ACTIVE" ] &&
               [ "$sys_target_dir" != "-" ] &&
               [ "$sys_log_size" -gt 0 ] &&
               [ $((now_epoch - last_sys_flush_epoch)) -ge "$FLUSH_INTERVAL_SECS" ]; then
                if flush_sys_log_to_target "$sys_target_dir" "$sys_target_file"; then
                    last_sys_flush_epoch="$now_epoch"
                    if [ "$flush_did_copy" = "1" ]; then
                        last_sys_flush_at="$(timestamp)"
                        last_sys_flush_epoch_value="$now_epoch"
                    fi
                    sys_log_size="$(sys_ram_log_size_bytes)"
                    reason="target-ready"
                else
                    flush_result="$?"
                    state="WAITING"
                    if [ "$flush_result" -eq 2 ]; then
                        reason="target-storage-full"
                    else
                        reason="target-syslog-flush-failed"
                    fi
                fi
            fi
        fi

        if [ "$target" != "$last_target" ] ||
           [ "$state" != "$last_state" ] ||
           [ "$reason" != "$last_reason" ] ||
           [ "$target_dir" != "$last_target_dir" ] ||
           [ "$target_file" != "$last_target_file" ]; then
            manager_log "state=${state} target=${target} dir=${target_dir} file=${target_file} reason=${reason}"
            last_target="$target"
            last_state="$state"
            last_reason="$reason"
            last_target_dir="$target_dir"
            last_target_file="$target_file"
        fi

        write_status "$state" "$target" "$target_device" "$target_dir" "$target_file" "$reason" "$RAM_LOG_FILE" "$last_log_write_at" "$last_flush_at" "$ram_log_size" "$last_log_write_epoch" "$last_flush_epoch_value" "$sys_target_file" "$last_sys_flush_at" "$last_sys_flush_epoch_value" "$sys_log_size"
        sleep "$POLL_INTERVAL_SECS"
    done
}

monotonic_seconds() {
    read -r monotonic_uptime monotonic_idle < /proc/uptime
    printf '%s\n' "${monotonic_uptime%%.*}"
}

stop_storage_worker() {
    # setsid gives the worker and its I/O commands a private process group.
    # Do not wait: a device in uninterruptible kernel I/O may not exit yet.
    if [ -n "${guard_worker_pid:-}" ]; then
        stop_owned_worker "$guard_worker_pid" "$guard_worker_identity"
    fi
    guard_worker_pid=""
    guard_worker_identity=""
}

stop_source_worker() {
    if [ -n "${guard_source_pid:-}" ]; then
        stop_owned_worker "$guard_source_pid" "$guard_source_identity"
    fi
    guard_source_pid=""
    guard_source_identity=""
}

worker_is_owned() {
    owned_pid="$1"
    owned_identity="$2"
    [ -n "$owned_identity" ] && [ "$owned_identity" != '-' ] || return 1
    read -r owned_stat 2>/dev/null < "/proc/$owned_pid/stat" || return 1
    owned_fields="${owned_stat##*) }"
    set -- $owned_fields
    [ "$#" -ge 20 ] || return 1
    [ "$2" = "$$" ] && [ "$owned_pid:${20}" = "$owned_identity" ] || return 1
    owned_group="$3"
    owned_session="$4"
}

stop_owned_worker() {
    # Never signal an expired numeric PID. Check parent and process start time
    # immediately before signaling, and never send a second signal after kill.
    worker_is_owned "$1" "$2" || return 0
    if [ "$owned_group" = "$owned_pid" ] && [ "$owned_session" = "$owned_pid" ]; then
        kill -KILL "-$owned_pid" 2>/dev/null || true
    else
        # setsid may not yet have run during very early supervisor shutdown.
        kill -KILL "$owned_pid" 2>/dev/null || true
    fi
}

guard_cleanup() {
    trap - EXIT
    trap '' INT TERM HUP
    stop_storage_worker
    stop_source_worker
    if [ -n "${guard_runtime_dir:-}" ]; then
        # This private mktemp directory contains only this manager's IPC files.
        rm -f "$guard_runtime_dir"/* 2>/dev/null || true
        rmdir "$guard_runtime_dir" 2>/dev/null || true
    fi
    write_status "STOPPED" "NONE" "-" "-" "-" "service-stopped" "$RAM_LOG_FILE" "-" "-" "0" "0" "0" "-" "-" "0" "0" || true
    rm -f "${STATUS_FILE}.tmp.$$" 2>/dev/null || true
}

source_loop() {
    source_identity=""
    # The first line remains a byte offset for compatibility with older state.
    # Restore identity too, avoiding replay of the source on manager restarts.
    if [ -f "$SYS_LOG_OFFSET_FILE" ]; then
        {
            read -r source_saved_offset || true
            read -r source_identity || true
        } < "$SYS_LOG_OFFSET_FILE"
    fi
    trap 'exit 0' INT TERM HUP
    while true; do
        printf '%s\n' "$(monotonic_seconds)" > "$SYS_PROGRESS_FILE"
        source_error=""
        if ! sync_sys_log_source_to_ram; then
            source_error="sys-log-sync-failed"
        fi
        printf '%s\n' "$source_error" > "$RUNTIME_DIR/source.status.tmp.$$"
        mv -f "$RUNTIME_DIR/source.status.tmp.$$" "$RUNTIME_DIR/source.status"
        sleep "$RAM_POLL_INTERVAL_SECS"
    done
}

check_worker_progress() {
    checked_pid="$1"
    checked_progress_file="$2"
    checked_last_progress="$3"
    checked_error_prefix="$4"
    checked_identity="$5"
    checked_error=""
    checked_progress=""
    if [ -f "$checked_progress_file" ]; then
        read -r checked_progress < "$checked_progress_file" || true
    fi
    case "$checked_progress" in
        ''|*[!0-9]*) ;;
        *) checked_last_progress="$checked_progress" ;;
    esac
    checked_now="$(monotonic_seconds)"
    if ! worker_is_owned "$checked_pid" "$checked_identity"; then
        checked_error="${checked_error_prefix}-worker-stopped"
    elif [ $((checked_now - checked_last_progress)) -ge "$STORAGE_TIMEOUT_SECS" ]; then
        stop_owned_worker "$checked_pid" "$checked_identity"
        checked_error="${checked_error_prefix}-timeout"
    fi
}

publish_guard_status() {
    guard_ram_size="$(ram_log_size_bytes 2>/dev/null || printf '0')"
    guard_sys_size="$(sys_ram_log_size_bytes 2>/dev/null || printf '0')"
    if [ -n "$guard_error" ] || [ ! -f "$guard_runtime_dir/storage.status" ]; then
        write_status "WAITING" "$DEFAULT_TARGET" "-" "-" "-" \
            "${guard_error:-storage-starting}" "$RAM_LOG_FILE" "-" "-" \
            "$guard_ram_size" "0" "0" "-" "-" "0" "$guard_sys_size"
        return
    fi

    # Only the RAM supervisor publishes public status. Refresh actual sizes
    # and heartbeat even when storage is slow; the worker writes a private file.
    guard_status_tmp="${STATUS_FILE}.tmp.$$"
    awk -v ram="$guard_ram_size" -v sys="$guard_sys_size" \
        -v stamp="$(timestamp)" -v epoch="$(date '+%s')" '
        /^RAM_LOG_SIZE_BYTES=/ { print "RAM_LOG_SIZE_BYTES=" ram; next }
        /^SYS_LOG_SIZE_BYTES=/ { print "SYS_LOG_SIZE_BYTES=" sys; next }
        /^UPDATED_AT=/ { print "UPDATED_AT=" stamp; next }
        /^UPDATED_AT_EPOCH=/ { print "UPDATED_AT_EPOCH=" epoch; next }
        { print }
    ' "$guard_runtime_dir/storage.status" > "$guard_status_tmp" || return 1
    mv -f "$guard_status_tmp" "$STATUS_FILE"
}

guard_sleep() {
    # A broken PATH sleep must not turn RAM protection into a busy loop.
    # On the target BusyBox supplies an independent, absolute-path fallback.
    sleep "$RAM_POLL_INTERVAL_SECS" && return 0
    [ "$guard_stop_requested" = 0 ] || return 0
    /bin/busybox sleep "$RAM_POLL_INTERVAL_SECS" && return 0
    # The installed service restarts us with RestartSec=5 if both timers fail.
    printf 'Log-manager timers failed; requesting service restart\n' >&2
    exit 1
}

prepare_guard_runtime() {
    mkdir -p "$(dirname "$STATUS_FILE")" || return 1
    if [ -z "$guard_runtime_dir" ]; then
        guard_runtime_dir="$(mktemp -d "${STATUS_FILE}.runtime.XXXXXX")" || {
            guard_runtime_dir=""
            return 1
        }
    fi
    printf '0\n' > "$guard_runtime_dir/app.generation" || return 1
    printf '0\n' > "$guard_runtime_dir/sys.generation" || return 1
}

retired_worker_present() {
    retired_pid="$1"
    retired_identity="$2"
    [ -n "$retired_pid" ] || return 1
    # Presence checks never signal a retired PID. Include the entire old group:
    # a killed shell may leave an I/O command in uninterruptible kernel sleep.
    # Even a reused group can only delay recovery, never kill another process.
    kill -0 "-$retired_pid" 2>/dev/null && return 0
    if [ -z "$retired_identity" ] || [ "$retired_identity" = '-' ]; then
        [ -d "/proc/$retired_pid" ]
        return "$?"
    fi
    [ "$(read_process_identity "$retired_pid" 2>/dev/null)" = "$retired_identity" ]
}

maintain_guard_worker() {
    maintained_kind="$1"
    maintained_pid="$2"
    maintained_identity="$3"
    maintained_progress="$4"
    maintained_error="$5"
    maintained_retry_at="$6"
    maintained_retired_pid="$7"
    maintained_retired_identity="$8"
    if [ "$maintained_kind" = storage ]; then
        maintained_progress_file="$guard_runtime_dir/progress"
        maintained_error_prefix=target-storage
    else
        maintained_progress_file="$guard_runtime_dir/source.progress"
        maintained_error_prefix=sys-log-copy
    fi

    if [ -n "$maintained_pid" ]; then
        check_worker_progress "$maintained_pid" "$maintained_progress_file" \
            "$maintained_progress" "$maintained_error_prefix" "$maintained_identity"
        maintained_progress="$checked_last_progress"
        maintained_error="$checked_error"
        if [ -n "$maintained_error" ]; then
            maintained_retired_pid="$maintained_pid"
            maintained_retired_identity="$maintained_identity"
            maintained_pid=""
            maintained_identity=""
            maintained_retry_at=$((guard_now + WORKER_RETRY_SECS))
        fi
    fi
    [ -z "$maintained_pid" ] || return 0
    [ "$guard_now" -ge "$maintained_retry_at" ] || return 0
    if retired_worker_present "$maintained_retired_pid" "$maintained_retired_identity"; then
        return 0
    fi
    maintained_retired_pid=""
    maintained_retired_identity=""
    maintained_retry_at=$((guard_now + WORKER_RETRY_SECS))
    # Remove an old heartbeat before launching; a failed IPC write is retried
    # later while the supervisor keeps trimming both buffers.
    if ! printf '%s\n' "$guard_now" > "$maintained_progress_file"; then
        maintained_error="${maintained_error_prefix}-runtime-unavailable"
        return 0
    fi
    if [ "$maintained_kind" = storage ]; then
        rm -f "$guard_runtime_dir/storage.status" || return 0
        LOG_SCRIPT_STATUS_FILE="$guard_runtime_dir/storage.status" \
        LOG_STORAGE_PROGRESS_FILE="$maintained_progress_file" \
        LOG_MANAGER_RUNTIME_DIR="$guard_runtime_dir" \
            setsid /bin/sh "$0" --storage-worker >/dev/null 2>&1 &
    else
        rm -f "$guard_runtime_dir/source.status" || return 0
        LOG_SYS_PROGRESS_FILE="$maintained_progress_file" \
        LOG_MANAGER_RUNTIME_DIR="$guard_runtime_dir" \
            setsid /bin/sh "$0" --sys-worker >/dev/null 2>&1 &
    fi
    maintained_pid=$!
    maintained_identity="$(read_process_identity "$maintained_pid")"
    maintained_progress="$guard_now"
    maintained_error=""
}

ram_guard_loop() {
    # These are polling/deadline values, not arbitrary shell expressions.
    for guard_value in "$MAX_RAM_LOG_BYTES" "$RAM_POLL_INTERVAL_SECS" \
        "$POLL_INTERVAL_SECS" "$STORAGE_TIMEOUT_SECS" "$WORKER_RETRY_SECS"; do
        case "$guard_value" in
            ''|*[!0-9]*) printf 'Invalid log-manager size or interval\n' >&2; exit 1 ;;
        esac
        [ "$guard_value" -gt 0 ] || exit 1
    done
    [ "$STORAGE_TIMEOUT_SECS" -gt "$POLL_INTERVAL_SECS" ] || {
        printf 'Storage timeout must exceed the storage poll interval\n' >&2
        exit 1
    }
    [ "$STORAGE_TIMEOUT_SECS" -gt "$RAM_POLL_INTERVAL_SECS" ] || exit 1

    guard_worker_pid=""
    guard_worker_identity=""
    guard_source_pid=""
    guard_source_identity=""
    guard_runtime_dir=""
    trap guard_cleanup EXIT
    guard_stop_requested=0
    # Defer shutdown until child identities are captured, including signals
    # received between launching a worker and recording its start time.
    trap 'guard_stop_requested=1' INT TERM HUP
    guard_runtime_ready=0
    guard_runtime_retry_at=0
    guard_last_progress=0
    guard_source_last_progress=0
    guard_worker_error=""
    guard_source_error=""
    guard_worker_retry_at=0
    guard_source_retry_at=0
    guard_worker_retired_pid=""
    guard_worker_retired_identity=""
    guard_source_retired_pid=""
    guard_source_retired_identity=""

    while true; do
        guard_error=""
        if ! ensure_ram_log_file; then
            guard_error="ram-log-unavailable"
        elif ! trim_ram_log_to_limit; then
            guard_error="ram-log-trim-failed"
        fi

        if ! ensure_sys_ram_log_file; then
            guard_error="${guard_error:-sys-ram-log-unavailable}"
        else
            # This loop performs no source reads or storage writes. Both kinds
            # of I/O run in separate workers with independent progress checks.
            if ! trim_sys_ram_log_to_limit; then
                guard_error="${guard_error:-sys-ram-log-trim-failed}"
            fi
        fi

        guard_now="$(monotonic_seconds)"
        if [ "$guard_runtime_ready" = 0 ] &&
           [ "$guard_now" -ge "$guard_runtime_retry_at" ]; then
            guard_runtime_retry_at=$((guard_now + WORKER_RETRY_SECS))
            if prepare_guard_runtime; then
                guard_runtime_ready=1
            fi
        fi
        if [ "$guard_runtime_ready" = 1 ]; then
            maintain_guard_worker storage "$guard_worker_pid" "$guard_worker_identity" \
                "$guard_last_progress" "$guard_worker_error" "$guard_worker_retry_at" \
                "$guard_worker_retired_pid" "$guard_worker_retired_identity"
            guard_worker_pid="$maintained_pid"
            guard_worker_identity="$maintained_identity"
            guard_last_progress="$maintained_progress"
            guard_worker_error="$maintained_error"
            guard_worker_retry_at="$maintained_retry_at"
            guard_worker_retired_pid="$maintained_retired_pid"
            guard_worker_retired_identity="$maintained_retired_identity"

            maintain_guard_worker source "$guard_source_pid" "$guard_source_identity" \
                "$guard_source_last_progress" "$guard_source_error" "$guard_source_retry_at" \
                "$guard_source_retired_pid" "$guard_source_retired_identity"
            guard_source_pid="$maintained_pid"
            guard_source_identity="$maintained_identity"
            guard_source_last_progress="$maintained_progress"
            guard_source_error="$maintained_error"
            guard_source_retry_at="$maintained_retry_at"
            guard_source_retired_pid="$maintained_retired_pid"
            guard_source_retired_identity="$maintained_retired_identity"
        else
            guard_error="${guard_error:-runtime-unavailable}"
        fi
        guard_error="${guard_error:-$guard_worker_error}"
        guard_error="${guard_error:-$guard_source_error}"
        if [ -z "$guard_error" ] && [ -f "$guard_runtime_dir/source.status" ]; then
            read -r guard_error < "$guard_runtime_dir/source.status" || true
        fi
        # A full /run must not terminate RAM maintenance due to a status error.
        publish_guard_status || true
        [ "$guard_stop_requested" = 0 ] || exit 0
        guard_sleep
        [ "$guard_stop_requested" = 0 ] || exit 0
    done
}

case "${1:-}" in
    --storage-worker)
        [ -n "$STORAGE_PROGRESS_FILE" ] && [ -n "$RUNTIME_DIR" ] || exit 1
        monitor_loop
        ;;
    --sys-worker)
        [ -n "$SYS_PROGRESS_FILE" ] && [ -n "$RUNTIME_DIR" ] || exit 1
        source_loop
        ;;
    '') ram_guard_loop ;;
    *) printf 'Unknown log-manager argument\n' >&2; exit 1 ;;
esac
